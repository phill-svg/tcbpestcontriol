{
  "name": "tcbpestreal",
  "compatibility_date": "2026-07-09",
  "main": "src/index.js",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_HUB", "class_name": "ChatHub" }
    ]
  },
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "d1_databases": [
    // Remote D1 database for the booking slot-lock/audit table (schema.sql).
    // Created 2026-08-04 via the Cloudflare API; this is the real production id.
    { "binding": "DB", "database_name": "tcb-booking-db", "database_id": "25dde6a5-146a-4ec7-9d4c-95d2d692e98f" }
  ],
  "observability": {
    "enabled": true
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatHub"] }
  ],
  "vars": {
    // Which repository the editor's "Sync to code" button commits to. The
    // token that authorises it is a secret (GITHUB_TOKEN), never a var --
    // set it in the Cloudflare dashboard, or with `wrangler secret put`.
    "GITHUB_REPO": "phill-svg/tcbpestcontriol",
    "VAPID_SUBJECT": "mailto:phill@tcbpestcontrolcanberra.com.au",
    "VAPID_PUBLIC_KEY": "BKGvQzfz5UyGkxVtEFiMt-ONioOrOWZFpooBQ_7ev6HCCa9LCymRv5LeHMvfFsSfPlOQbGwWdC5QX3jFS7Apdoo"
  }
}
